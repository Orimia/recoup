# VandyLoop production env. Copy to your host's env settings (Render/Vercel/etc).
# Required values are marked REQUIRED. The app refuses to boot in production
# without SESSION_SECRET (see src/instrumentation.ts).

# --- Required ---
SESSION_SECRET=          # REQUIRED: long random string. Signs sessions + bin codes.
NODE_ENV=production

# --- Strongly recommended for a real launch ---
BIN_CODE_SECRET=         # random string; falls back to SESSION_SECRET if unset
ADMIN_KEY=               # protects the operator claw-back endpoint (/api/admin/void)
ALLOWED_EMAIL_DOMAINS=vanderbilt.edu   # "*" allows anyone (don't use for real launch)
STRICT_VERIFICATION=true               # require presence (geofence or bin code) to earn
APP_URL=https://your-app.onrender.com  # base URL for email verification links

# --- Optional integrations ---
ANTHROPIC_API_KEY=       # enables live Claude vision (else labeled heuristic)
VL_VISION_MODEL=claude-haiku-4-5-20251001
RESEND_API_KEY=          # sends real verification emails (else dev console link)
RESEND_FROM=VandyLoop <verify@yourdomain.edu>

# --- Real-event data (optional) ---
VL_SEED_PATH=            # path to a JSON file of real bins/teams/rewards (see config/launch.seed.example.json)

# --- Tunables (sensible defaults; override only if needed) ---
# GEOFENCE_RADIUS_M=150
# BIN_CODE_WINDOW_SEC=90
# DAILY_DEPOSIT_CAP=20
# SIGNUPS_PER_IP_PER_HOUR=40
# LOGINS_PER_IP_PER_10MIN=50
# MAX_FAILED_LOGINS=5
# LOCKOUT_MINUTES=15
